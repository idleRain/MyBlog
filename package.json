{
  "name": "myblog",
  "private": true,
  "version": "1.0.0",
  "description": "MyBlog - 一个包含 Go 后端和 SvelteKit 前端的 Monorepo 项目",
  "type": "module",
  "author": "IdleRain",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "tsx scripts/dev.ts",
    "dev:server": "tsx scripts/dev.ts --server",
    "dev:web": "tsx scripts/dev.ts --web",
    "dev:admin": "tsx scripts/dev.ts --admin",
    "build": "tsx scripts/build.ts",
    "build:clean": "tsx scripts/build.ts --clean",
    "build:production": "tsx scripts/build.ts --production",
    "build:server": "tsx scripts/build.ts --server-only",
    "build:web": "tsx scripts/build.ts --web-only",
    "build:fast": "tsx scripts/build.ts --skip-tests --skip-lint",
    "build:apps": "tsx scripts/build-web.ts && tsx scripts/build-admin.ts",
    "measure:assets": "tsx scripts/measure-assets.ts",
    "check:fonts": "tsx scripts/check-font-bundle.ts",
    "test": "pnpm run test:server && pnpm run test:packages && pnpm run test:apps && pnpm run contract:check",
    "test:server": "tsx scripts/go-tools.ts test",
    "test:packages": "pnpm --filter @myblog/api --filter @myblog/auth --filter @myblog/http run typecheck && pnpm --filter @myblog/api --filter @myblog/auth --filter @myblog/http run test",
    "test:apps": "pnpm -r --parallel --stream --filter @myblog/web --filter @myblog/admin run test",
    "typecheck:web": "pnpm -r --parallel --stream --filter @myblog/web --filter @myblog/admin run check",
    "lint": "pnpm run lint:web && pnpm run lint:server",
    "lint:web": "pnpm -r --parallel --stream --filter @myblog/web --filter @myblog/admin run lint",
    "lint:server": "tsx scripts/go-tools.ts vet && tsx scripts/go-tools.ts lint",
    "format": "pnpm run format:web && pnpm run format:server",
    "format:web": "pnpm -r --parallel --stream --filter @myblog/web --filter @myblog/admin run format",
    "format:server": "tsx scripts/go-tools.ts format",
    "format:check": "tsx scripts/format-check.ts",
    "clean": "pnpm run clean:server && pnpm run clean:web",
    "clean:server": "tsx scripts/go-tools.ts clean",
    "clean:web": "tsx scripts/clean-web.ts",
    "check": "pnpm -r --parallel --stream --filter @myblog/web --filter @myblog/admin run check",
    "quality": "pnpm run format && pnpm run lint && pnpm run test",
    "go:lint-install": "tsx scripts/go-tools.ts lint-install",
    "go:quality": "tsx scripts/go-tools.ts quality",
    "go:vulncheck": "tsx scripts/go-tools.ts vulncheck",
    "audit:deps": "pnpm audit --audit-level=high --registry=https://registry.npmjs.org/",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:create": "tsx scripts/migrate.ts create",
    "migrate:up": "tsx scripts/migrate.ts up",
    "migrate:down": "tsx scripts/migrate.ts down",
    "migrate:version": "tsx scripts/migrate.ts version",
    "seed:admin": "tsx scripts/seed.ts",
    "contract:check": "cd server && go test ./internal/handler/ -run Fixture -count=1 && cd .. && pnpm --filter @myblog/api run typecheck && pnpm --filter @myblog/api run test",
    "prepare": "husky install",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/compat": "^1.2.5",
    "@eslint/js": "^9.18.0",
    "@sveltejs/adapter-node": "catalog:",
    "@sveltejs/adapter-static": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/forms": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "^24.0.13",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-svelte": "^3.10.1",
    "globals": "^16.0.0",
    "husky": "^9.0.11",
    "lint-staged": "^17.6.0",
    "prettier": "^3.6.2",
    "prettier-plugin-css-order": "^2.1.2",
    "prettier-plugin-sort-imports": "^1.8.8",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "typescript-eslint": "^8.20.0",
    "unplugin-auto-import": "catalog:",
    "vite": "catalog:",
    "vite-plugin-devtools-json": "catalog:",
    "vite-plugin-json5": "^1.4.4"
  },
  "keywords": [
    "monorepo",
    "go",
    "svelte",
    "blog",
    "fullstack"
  ],
  "lint-staged": {
    "apps/**/src/**/*.{js,ts,jsx,tsx,svelte}": [
      "prettier --write"
    ],
    "*.{json,yaml,yml}": [
      "prettier --write"
    ],
    "server/**/*.go": [
      "gofmt -w",
      "tsx scripts/lint-staged-goimports.ts"
    ]
  }
}
