{
  // ESLint（flat config 自动检测；workingDirectories 供多根工作区定位子应用）
  "eslint.workingDirectories": ["apps/web", "apps/admin"],

  // Svelte
  "svelte.enable-ts-plugin": true,

  // Go（编辑器内诊断与格式化交给 gopls，lint 由 lint:server 的 golangci-lint 负责）
  "go.formatTool": "default",
  "go.toolsManagement.autoUpdate": true,

  // 文件关联
  "files.associations": {
    "*.yaml": "yaml",
    "*.yml": "yaml",
    "go.mod": "go",
    "go.sum": "go",
    ".air.toml": "toml",
    ".air.simple.toml": "toml"
  },

  // 编辑器
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.rulers": [80, 100],

  // TypeScript（与 prettier 无分号风格保持一致，import 排序交由 prettier 插件处理）
  "typescript.preferences.noSemicolons": true,
  "typescript.updateImportsOnFileMove.enabled": "always",

  // Prettier
  "prettier.configPath": "./prettier.config.js",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[svelte]": {
    "editor.defaultFormatter": "svelte.svelte-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },

  // Git（仅保留自动拉取；智能提交与自动同步会引入误推风险，统一交由 Git hooks 管理）
  "git.autofetch": true,

  // 终端（PowerShell 7 的 Windows Terminal profile 名）
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.cwd": "${workspaceFolder}"
}
