{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Go Server",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/server/cmd/myblog",
      "cwd": "${workspaceFolder}/server",
      "env": {},
      "args": [],
      "console": "integratedTerminal",
      "stopOnEntry": false
    },
    {
      "name": "Debug Go Server (Remote)",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "remotePath": "${workspaceFolder}/server",
      "port": 2345,
      "host": "127.0.0.1",
      "showLog": true
    },
    {
      "name": "Debug Go Tests",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}/server",
      "cwd": "${workspaceFolder}/server",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug Web (SvelteKit 前台)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
      "args": [
        "dev",
        "--mode",
        "dev"
      ],
      "cwd": "${workspaceFolder}/apps/web",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "[Ll]ocal:.*?(https?://[^\\s]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Debug Admin (SvelteKit 后台)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
      "args": [
        "dev",
        "--mode",
        "dev"
      ],
      "cwd": "${workspaceFolder}/apps/admin",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "[Ll]ocal:.*?(https?://[^\\s]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Debug Chrome (Frontend)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8899",
      "webRoot": "${workspaceFolder}/apps/web/src",
      "sourceMaps": true,
      "userDataDir": "${workspaceFolder}/.vscode/chrome-debug-profile",
      "runtimeArgs": [
        "--disable-web-security"
      ]
    },
    {
      "name": "Debug Chrome (Admin)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:9988",
      "webRoot": "${workspaceFolder}/apps/admin/src",
      "sourceMaps": true,
      "userDataDir": "${workspaceFolder}/.vscode/chrome-debug-profile-admin",
      "runtimeArgs": [
        "--disable-web-security"
      ]
    }
  ],
  "compounds": [
    {
      "name": "Debug Full Stack",
      "configurations": [
        "Debug Go Server",
        "Debug Web (SvelteKit 前台)",
        "Debug Admin (SvelteKit 后台)"
      ],
      "stopAll": true
    },
    {
      "name": "Debug Frontend + Chrome",
      "configurations": [
        "Debug Web (SvelteKit 前台)",
        "Debug Chrome (Frontend)"
      ],
      "stopAll": true
    }
  ]
}
