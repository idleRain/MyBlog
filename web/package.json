{
  "name": "web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev --mode dev",
    "build": "vite build --mode prod",
    "preview": "vite preview --mode prod",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write src",
    "lint": "prettier --write src && eslint src --fix --ext .js,.ts,.svelte"
  },
  "devDependencies": {
    "@fontsource/fira-mono": "^5.3.0",
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^1.34.0",
    "@neoconfetti/svelte": "^2.0.0",
    "@sveltejs/adapter-auto": "^6.1.1",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/table-core": "^9.1.2",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "autoprefixer": "^10.5.4",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "embla-carousel-svelte": "^8.6.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "layerchart": "2.3.0",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.2",
    "postcss": "^8.5.26",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "unplugin-auto-import": "^21.1.0",
    "vaul-svelte": "^1.0.0-next.7",
    "vite": "^7.3.6",
    "vite-plugin-devtools-json": "^1.1.0"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.24.1",
    "formsnap": "^2.0.1",
    "gsap": "^3.15.0",
    "ky": "^1.14.3",
    "mitt": "^3.0.1",
    "sveltekit-superforms": "^2.30.2",
    "zod": "^4.4.3"
  }
