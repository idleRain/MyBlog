{
  "folders": [
    {
      "name": "🏠 MyBlog (Root)",
      "path": "."
    },
    {
      "name": "🔧 Server (Go)",
      "path": "./server"
    },
    {
      "name": "🎨 Web (SvelteKit 前台)",
      "path": "./apps/web"
    },
    {
      "name": "🛠 Admin (SvelteKit 后台)",
      "path": "./apps/admin"
    },
    {
      "name": "📜 Scripts",
      "path": "./scripts"
    },
    {
      "name": "📖 Documentation",
      "path": "./docs"
    }
  ],
  "settings": {
    // 工作区级文件隐藏与搜索排除，对全部根 folder 生效；
    // 语言、工具链、任务与调试设置统一由 .vscode/ 目录承载，避免双源重复。
    "files.exclude": {
      "**/node_modules": true,
      "**/tmp": true,
      "**/bin": true,
      "**/.svelte-kit": true,
      "**/dist": true,
      "**/build": true,
      "**/.husky/_": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/tmp": true,
      "**/bin": true,
      "**/.svelte-kit": true,
      "**/dist": true,
      "**/build": true,
      "**/vendor": true,
      "**/*.log": true,
      "**/go.sum": true
    }
  }
}
