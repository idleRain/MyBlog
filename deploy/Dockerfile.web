# 前台镜像：构建 adapter-node 产物后由 node 直接运行。
# 前端 API 地址经构建参数注入：浏览器端走同源 /api，SSR 端直连容器网络内的 server 服务。

# 阶段一：构建前台产物
FROM node:22-alpine AS builder
WORKDIR /repo
RUN corepack enable
# 拷贝 monorepo 全部源码，pnpm 按 workspace 配置解析本地包依赖
COPY . .
# 冻结 lock 安装依赖，确保镜像内依赖与开发环境一致
RUN pnpm install --frozen-lockfile
# 生产构建参数：SSR 端请求后端容器，浏览器端请求同源网关
ARG VITE_BASE_URL=/api
ARG VITE_PROXY_URL=http://server:3000
ARG VITE_REQUEST_TIMEOUT=15000
ENV VITE_BASE_URL=$VITE_BASE_URL \
    VITE_PROXY_URL=$VITE_PROXY_URL \
    VITE_REQUEST_TIMEOUT=$VITE_REQUEST_TIMEOUT
RUN pnpm --filter @myblog/web run build

# 生产依赖阶段：adapter-node 产物保留裸包导入，运行阶段必须能解析这些包。
# Vite 的 SSR 构建只内联 @myblog/* 本地源码包，shiki、@shikijs/*、rehype-*、remark-*、unified、
# unist-util-visit、ky 与 gsap 均以外部引用形式留在产物中，因此需要安装生产依赖随镜像分发。
# polka、sirv 与 @sveltejs/kit 由 adapter-node 直接内联进 build 产物，不需要在运行阶段安装。
FROM builder AS prod-deps
WORKDIR /prod
# 拷贝 workspace 清单与锁文件，pnpm 依据它们还原与构建阶段一致的依赖树
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
# 本地包以 workspace 协议被引用，缺少各自的清单会导致安装无法解析
COPY apps/web/package.json ./apps/web/package.json
COPY packages/api/package.json ./packages/api/package.json
COPY packages/auth/package.json ./packages/auth/package.json
COPY packages/http/package.json ./packages/http/package.json
COPY packages/shared/package.json ./packages/shared/package.json
COPY packages/ui/package.json ./packages/ui/package.json
# 停用 pnpm 默认的符号链接布局，改用扁平 node_modules，使产物在任意工作目录下都能解析依赖
RUN pnpm install --prod --frozen-lockfile --ignore-scripts --config.node-linker=hoisted

# 阶段二：运行前台产物
FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
# adapter-node 产物为 ESM 且保留外部依赖引用，运行阶段必须随镜像提供 node_modules
COPY --from=builder /repo/apps/web/build ./build
COPY --from=prod-deps /prod/node_modules ./node_modules
EXPOSE 3000
CMD ["node", "build"]
