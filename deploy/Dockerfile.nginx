# 网关镜像：构建 admin 静态产物并交由 nginx 托管，同时反代前台 SSR 与后端 API/uploads。

# 阶段一：构建 admin 静态产物
FROM node:22-alpine AS builder
WORKDIR /repo
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile
# admin 为纯浏览器应用，仅需同源 /api 地址
ARG VITE_BASE_URL=/api
ENV VITE_BASE_URL=$VITE_BASE_URL
RUN pnpm --filter @myblog/admin run build

# 阶段二：nginx 运行镜像
FROM nginx:1.27-alpine
# admin 静态产物置于 /usr/share/nginx/html/admin，与 nginx.conf 的 root 映射对齐
COPY --from=builder /repo/apps/admin/build /usr/share/nginx/html/admin
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
