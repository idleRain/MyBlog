# MyBlog 生产环境变量模板。
# 使用方式：复制本文件为仓库根目录 .env 后填写真实值，严禁将真实密钥提交到版本库。

# MySQL root 口令，必须替换为随机强口令
MYSQL_ROOT_PASSWORD=please-change-me

# 业务数据库名，默认 myblog
MYSQL_DATABASE=myblog

# nginx 对外暴露端口，默认 80
HTTP_PORT=80

# 备份产物在宿主机上的落盘目录，默认 ./backups（仓库根相对路径）。
# 生产环境应显式设置为独立于 Docker 数据目录的磁盘或挂载点，否则容器与备份同盘损坏时会一并丢失。
BACKUP_HOST_DIR=./backups

# 备份保留天数，默认 14，超过保留期的备份目录会被清理。
BACKUP_RETENTION_DAYS=14
