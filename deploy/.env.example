# MyBlog 生产环境变量模板。
# 使用方式：复制本文件为仓库根目录 .env 后填写真实值，严禁将真实密钥提交到版本库。

# MySQL root 口令，必须替换为随机强口令
MYSQL_ROOT_PASSWORD=please-change-me

# 业务数据库名，默认 myblog
MYSQL_DATABASE=myblog

# JWT 访问令牌与刷新令牌密钥，必须互不相同且为随机强值
MYBLOG_JWT_ACCESS_SECRET=please-change-me-access
MYBLOG_JWT_REFRESH_SECRET=please-change-me-refresh

# nginx 对外暴露端口，默认 80
HTTP_PORT=80
