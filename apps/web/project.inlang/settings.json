{
  "$schema": "https://inlang.com/schema/project-settings",
  "modules": [
    "https://cdn.jsdelivr.net/npm/@inlang/plugin-i18next@latest/dist/index.js",
    "https://cdn.jsdelivr.net/npm/@inlang/plugin-m-function-matcher@2/dist/index.js"
  ],
  "plugin.inlang.i18next": {
    "pathPattern": {
      "common": "./messages/{locale}/common.json5",
      "ui": "./messages/{locale}/ui.json5",
      "auth": "./messages/{locale}/auth.json5",
      "home": "./messages/{locale}/home.json5",
      "blog": "./messages/{locale}/blog.json5",
      "account": "./messages/{locale}/account.json5",
      "comment": "./messages/{locale}/comment.json5",
      "category": "./messages/{locale}/category.json5",
      "author": "./messages/{locale}/author.json5",
      "contact": "./messages/{locale}/contact.json5",
      "projects": "./messages/{locale}/projects.json5"
    }
  },
  "baseLocale": "zh",
  "locales": ["zh", "en"]
}
