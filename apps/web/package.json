{
  "name": "@myblog/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev --mode dev",
    "build": "vite build --mode prod",
    "preview": "vite preview --mode prod",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write src",
    "lint": "eslint src --ext .js,.ts,.svelte"
  },
  "devDependencies": {
    "@fontsource/fira-mono": "^5.3.0",
    "@lucide/svelte": "catalog:",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "mode-watcher": "catalog:",
    "svelte": "catalog:",
    "svelte-sonner": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@inlang/paraglide-js": "^2.24.1",
    "@myblog/api": "workspace:*",
    "@myblog/auth": "workspace:*",
    "@myblog/http": "workspace:*",
    "@myblog/shared": "workspace:*",
    "@myblog/ui": "workspace:*",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/rehype": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "gsap": "^3.15.0",
    "ky": "catalog:",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  }
}
