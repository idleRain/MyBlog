{
  "name": "@myblog/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev --mode dev",
    "build": "vite build --mode prod",
    "preview": "vite preview --mode prod",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write src",
    "lint": "eslint src --ext .js,.ts,.svelte"
  },
  "devDependencies": {
    "@fontsource/fira-mono": "^5.3.0",
    "@lucide/svelte": "catalog:",
    "mode-watcher": "catalog:",
    "svelte": "catalog:",
    "svelte-sonner": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.24.1",
    "@myblog/api": "workspace:*",
    "@myblog/http": "workspace:*",
    "@myblog/shared": "workspace:*",
    "@myblog/ui": "workspace:*",
    "gsap": "^3.15.0",
    "ky": "catalog:"
  }
}
